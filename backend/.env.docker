# ============================================================
# Docker 환경변수 덮어쓰기 (backend/.env 기반)
# ============================================================
# .env의 localhost 값을 Docker 컨테이너 이름으로 덮어씁니다.
# ============================================================

# Database - postgres:5432 (외부: 15432)
DATABASE_URL=postgresql+asyncpg://oaria:oaria_dev_2024@postgres:5432/oaria

# Weaviate - weaviate:8080 (외부: 18080)
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080

# Redis - redis:6379 (외부: 16379)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO - minio:9000 (외부: 19000)
S3_ENDPOINT=http://minio:9000

# Reranker 비활성화 (CPU에서 모델 로딩이 너무 느림)
RERANKER_ENABLED=false
