# ============================================================
# OARIA User Backend (FastAPI) 환경변수
# ============================================================
#
# ────────────────────────────────────────────────────────────
# Docker 컨테이너 참고 (내부 통신용)
# ────────────────────────────────────────────────────────────
# 로컬 개발 시: localhost:{외부포트} 사용
# Docker 내부 통신 시: {서비스명}:{내부포트} 사용
#
#   postgres:5432 (외부: 15432)
#   redis:6379 (외부: 16379)
#   minio:9000 (외부: 19000)
#   weaviate:8080 (외부: 18080)
#   service-backend:8000 (외부: 8000)
#
# ============================================================

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# 로컬: localhost:15432 | Docker: postgres:5432
DATABASE_URL=postgresql+asyncpg://oaria:oaria_dev_2024@localhost:15432/oaria

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
FRONTEND_URL=http://localhost:3000

# App
DEBUG=true

# ─────────────────────────────────────────────────────────────
# Weaviate (Vector Database)
# ─────────────────────────────────────────────────────────────
# 로컬: localhost:18080 | Docker: weaviate:8080
WEAVIATE_HOST=localhost
WEAVIATE_PORT=18080

# ─────────────────────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# GATE2_ENABLED를 통해서 게이트 2를 온오프
GATE2_ENABLED=false
