# ============================================
# 암 논문 수집 서비스 환경 변수
# ============================================
# .env.example → .env로 복사 후 사용
# 프로덕션 배포 시 반드시 모든 값을 검토하고 변경할 것

# ============================================
# Database (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=15432
DB_USER=oaria
DB_PASSWORD=oaria_dev_2024
DB_NAME=oaria

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=16379

# ============================================
# Object Storage (MinIO/S3)
# ============================================
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_2024
S3_BUCKET=oaria-papers

# ============================================
# Vector Database (Weaviate)
# ============================================
WEAVIATE_HOST=localhost
WEAVIATE_PORT=18080

# ============================================
# Celery Monitoring (Flower)
# ============================================
# 프로덕션에서는 반드시 강력한 비밀번호로 변경할 것
FLOWER_HOST=localhost
FLOWER_PORT=15555
FLOWER_USER=admin
FLOWER_PASSWORD=flower_dev_2024

# ============================================
# OpenAI API (임베딩용)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Admin Backend (NestJS)
# ============================================
# JWT 시크릿 - 프로덕션에서 반드시 변경
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:13000/auth/google/callback

# Frontend URL (CORS, 리다이렉트용)
FRONTEND_URL=http://localhost:13001

# ============================================
# Docker Compose 포트 매핑 참고
# ============================================
# PostgreSQL: 15432 (host) → 5432 (container)
# Redis: 16379 (host) → 6379 (container)
# MinIO API: 19000 (host) → 9000 (container)
# MinIO Console: 19001 (host) → 9001 (container)
# Weaviate: 18080 (host) → 8080 (container)
# Flower: 15555 (host) → 5555 (container)
# Admin Backend: 13000 (host) → 3000 (container)
# Admin Frontend: 13001 (host) → 3000 (container)
