# ============================================
# OARIA Docker Compose 환경 변수
# ============================================
# .env.example → .env로 복사 후 사용
# docker-compose up -d 실행 시 필요한 변수만 포함

# ============================================
# OpenAI API (필수)
# ============================================
# 임베딩 워커(celery-worker-embed)에서 사용
# 이 값이 없으면 임베딩 기능이 동작하지 않음
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Frontend API URLs (Docker 배포 시 필수)
# ============================================
# 브라우저에서 접근하는 API URL
# 로컬: http://localhost:8000, http://localhost:13000
# 클라우드: https://api.yourdomain.com, https://admin-api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:13000

# ============================================
# Celery Monitoring - Flower (선택)
# ============================================
# 기본값이 있어 설정하지 않아도 동작함
# 프로덕션에서는 반드시 변경할 것
# FLOWER_USER=admin
# FLOWER_PASSWORD=flower_dev_2024

# ============================================
# JWT Secret (프로덕션 필수)
# ============================================
# 프로덕션에서는 반드시 강력한 시크릿으로 변경할 것
# JWT_SECRET=your-strong-secret-key-here

# ============================================
# 포트 매핑 참고 (로컬 → 컨테이너)
# ============================================
# PostgreSQL: localhost:15432 → postgres:5432
# Redis: localhost:16379 → redis:6379
# MinIO API: localhost:19000 → minio:9000
# MinIO Console: localhost:19001 → minio:9001
# Weaviate: localhost:18080 → weaviate:8080
# Flower: localhost:15555 → flower:5555
#
# User Service: localhost:3000 → service-frontend:3000
# User Backend: localhost:8000 → service-backend:8000
# Admin Frontend: localhost:13001 → admin-frontend:13001
# Admin Backend: localhost:13000 → admin-backend:13000

# ============================================
# Docker 컨테이너 이름 (내부 통신용)
# ============================================
# docker-compose.yml 서비스 이름:
#   - postgres: PostgreSQL 데이터베이스
#   - redis: Redis 캐시/브로커
#   - minio: S3 호환 오브젝트 스토리지
#   - weaviate: 벡터 데이터베이스
#   - flower: Celery 모니터링
#   - celery-worker-backfill: 논문 수집 워커
#   - celery-worker-embed: 임베딩 워커
#   - celery-beat: Celery 스케줄러
#   - service-backend: User Backend (FastAPI)
#   - service-frontend: User Frontend (Next.js)
#   - admin-backend: Admin Backend (NestJS)
#   - admin-frontend: Admin Frontend (Next.js)
