# ============================================
# OARIA Docker Compose 환경 변수
# ============================================
# .env.example → .env로 복사 후 사용
# docker-compose up -d 실행 시 필요한 변수만 포함

# ============================================
# OpenAI API (필수)
# ============================================
# 임베딩 워커(celery-worker-embed)에서 사용
# 이 값이 없으면 임베딩 기능이 동작하지 않음
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Celery Monitoring - Flower (선택)
# ============================================
# 기본값이 있어 설정하지 않아도 동작함
# 프로덕션에서는 반드시 변경할 것
# FLOWER_USER=admin
# FLOWER_PASSWORD=flower_dev_2024

# ============================================
# 포트 매핑 참고
# ============================================
# PostgreSQL: localhost:15432
# Redis: localhost:16379
# MinIO API: localhost:19000
# MinIO Console: localhost:19001
# Weaviate: localhost:18080
# Flower: localhost:15555
