# OARIA Spike Environment Variables
# Copy this file to .env and fill in values

# =============================================================================
# MODE: 초기 모드 (local 또는 gcp)
# =============================================================================
MODE=local

# =============================================================================
# 데이터베이스 설정 - 아래 두 가지 중 하나만 선택!
# =============================================================================

# =========== 옵션 1: 단일 모드 (스위칭 불가) ===========
# DATABASE_URL 하나만 설정하면 해당 DB만 사용
# DATABASE_URL=postgresql://oaria:oaria@db:5432/oaria
# DATABASE_URL=mysql://root:password@localhost:3306/oaria

# =========== 옵션 2: 런타임 스위칭 (프론트엔드에서 전환 가능) ===========
# LOCAL_DATABASE_URL과 GCP_DATABASE_URL 둘 다 설정 시
# 사이드바에서 클릭으로 DB 전환 가능!
# (DATABASE_URL은 필요 없음)

LOCAL_DATABASE_URL=postgresql://oaria:oaria@db:5432/oaria
GCP_DATABASE_URL="mysql://admin:password@host:3306/oaria"

# =============================================================================
# Storage Configuration
# =============================================================================
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/local_storage

# GCP mode - GCS bucket name
# GCS_BUCKET=oaria-bio-bucket

# =============================================================================
# Qdrant Configuration
# =============================================================================
QDRANT_URL=http://qdrant:6333

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# PubMed API (Optional - for higher rate limits)
# =============================================================================
# NCBI_API_KEY=your-ncbi-api-key

# =============================================================================
# Embedding Configuration
# =============================================================================
# Model options:
#   - all-MiniLM-L6-v2       (384 dims, FAST, general purpose)
#   - pritamdeka/S-PubMedBert-MS-MARCO (768 dims, SLOW, biomedical specialized)
#
# ⚠️ 모델 변경 시 Qdrant 컬렉션 재생성 필요! (docker-compose down -v 후 재시작)
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64
