# FAST DEBUG
FAST_DEBUG=1
MAX_SAMPLES=100
EPOCHS=1
BATCH_SIZE=4
LR=5e-5

# MODEL
MODEL_NAME=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract
OUTPUT_DIR=./cancer-ner-pubmedbert

# HUB (optional)
PUSH_TO_HUB=1
HUB_MODEL_ID=user/cancer-ner-pubmedbert
# PRIVATE repo는 CLI에서 먼저 만들어두는 걸 추천 (Settings에서)
HUB_PRIVATE=1
