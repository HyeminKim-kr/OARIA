# ============================================
# BioNER Training Environment Variables
# ============================================

# MODE: bc5cdr or multiner
MODE=bc5cdr

# 0 = full training, 1 = fast debug mode
FAST_DEBUG=0

# Reproducibility
SEED=42

# ============================================
# BC5CDR NER (MODE=bc5cdr)
# Labels: O, B-Chemical, I-Chemical, B-Disease, I-Disease
# ============================================
BC5CDR_OUTPUT_DIR=./runs/cancer-ner-pubmedbert
BC5CDR_HUB_MODEL_ID=vparka/cancer-ner-pubmedbert

# ============================================
# Multi-NER (MODE=multiner)
# Labels: O, B-Disease, I-Disease, B-Chemical, I-Chemical, B-Gene, I-Gene
# ============================================
MULTINER_OUTPUT_DIR=./runs/pubmedbert-multiner
MULTINER_HUB_MODEL_ID=vparka/pubmedbert-multiner

# ============================================
# Common Hub Settings
# ============================================
HF_HUB_PRIVATE=true
PUSH_TO_HUB=0
