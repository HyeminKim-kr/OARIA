# OARIA Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for AI answers)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Choose model (default: gpt-4o)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Qdrant (default values work for local Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# PostgreSQL (default values work for local Docker)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=oaria
DATABASE_USER=oaria
DATABASE_PASSWORD=oaria123
