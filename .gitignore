# --------------------------------------------------------------
# Auto Generated/Compiled Output (자동 생성/컴파일 결과)
# --------------------------------------------------------------
# Dependencies (의존성)
/node_modules
.pnp
.pnp.*
.pnpm-debug.log*

# Yarn 2+ Zero-Install (Yarn Berry)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks
.yarn/install-state.gz

# Compiled JS/TS/Build Output (컴파일된 빌드 출력)
/dist
/build
/out
/.next/
*.tsbuildinfo
next-env.d.ts

# Python Artifacts (Python 결과물)
/python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.egg-info/
.eggs/
build/
dist/
.python-version
venv/
.venv/


# --------------------------------------------------------------
# Logs and Diagnostics (로그 및 진단 파일)
# --------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json # Node.js Diagnostic reports


# --------------------------------------------------------------
# Environment Variables (환경 변수 파일) - [사용자 설정 반영]
# --------------------------------------------------------------
# .env 파일을 Git에 포함시키지 않음.
.env*
# 그러나 예시 파일은 포함하도록 예외 처리 (Optional)
!.env.example
!.env.*.example
env_backup


# --------------------------------------------------------------
# Testing and Coverage (테스트 및 커버리지 결과)
# --------------------------------------------------------------
/coverage
/.nyc_output
test-report.xml
/test # (주의: 코드 파일이 아닌 테스트 관련 출력 폴더일 경우)


# --------------------------------------------------------------
# IDEs, Editors, and Configuration (IDE 및 에디터 설정)
# --------------------------------------------------------------
# General IDE/Editor files
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code Specific (VS Code 설정)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


# --------------------------------------------------------------
