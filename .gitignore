# Custom Project Specific Files (커스텀 프로젝트 파일)
# --------------------------------------------------------------
/doc
/documentation
/output
/app/db/mongo/generated/*
/app/metadata.ts
/docker/mariadb/db/data/*
pids
*.pid
*.seed
