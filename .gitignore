# --------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
*.pem
.vercel
.cache/

# macOS Volume Files
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Temporary/Cache Directories
.temp
.tmp
/temp
backup/
/dump.rdb # Redis dump file
test.http


