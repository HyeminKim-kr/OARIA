# ============================================================
# Docker 환경변수 덮어쓰기 (admin/backend/.env 기반)
# ============================================================
# .env의 localhost 값을 Docker 컨테이너 이름으로 덮어씁니다.
# ============================================================

# Database - postgres:5432 (외부: 15432)
DB_HOST=postgres
DB_PORT=5432

# Redis - redis:6379 (외부: 16379)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO - minio:9000 (외부: 19000)
S3_ENDPOINT=http://minio:9000

# Weaviate - weaviate:8080 (외부: 18080)
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080

# Flower - flower:5555 (외부: 15555)
FLOWER_HOST=flower
FLOWER_PORT=5555

# User Backend - service-backend:8000 (외부: 8000)
USER_BACKEND_URL=http://service-backend:8000
