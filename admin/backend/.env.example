# ============================================================
# OARIA Admin Backend 환경변수
# ============================================================
#
# 환경별 필수 여부:
#   - development/test: 디폴트값 사용 가능 (선택)
#   - production/staging: 모든 변수 필수
#
# ────────────────────────────────────────────────────────────
# Docker 컨테이너 참고 (내부 통신용)
# ────────────────────────────────────────────────────────────
# 로컬 개발 시: localhost:{외부포트} 사용
# Docker 내부 통신 시: {서비스명}:{내부포트} 사용
#
#   postgres:5432 (외부: 15432)
#   redis:6379 (외부: 16379)
#   minio:9000 (외부: 19000)
#   weaviate:8080 (외부: 18080)
#   flower:5555 (외부: 15555)
#   service-backend:8000 (외부: 8000)
#   admin-backend:13000 (외부: 13000)
#
# ============================================================

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=13000

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# 로컬: localhost:15432 | Docker: postgres:5432
DB_HOST=localhost
DB_PORT=15432
DB_USER=oaria
DB_PASSWORD=oaria_dev_2024
DB_NAME=oaria

# ─────────────────────────────────────────────────────────────
# Redis (Celery Broker)
# ─────────────────────────────────────────────────────────────
# 로컬: localhost:16379 | Docker: redis:6379
REDIS_HOST=localhost
REDIS_PORT=16379

# ─────────────────────────────────────────────────────────────
# S3/MinIO (Object Storage)
# ─────────────────────────────────────────────────────────────
# 로컬: http://localhost:19000 | Docker: http://minio:9000
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_2024
S3_BUCKET=oaria-papers

# ─────────────────────────────────────────────────────────────
# Auth - JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ─────────────────────────────────────────────────────────────
# Auth - Google OAuth
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:13000/auth/google/callback

# ─────────────────────────────────────────────────────────────
# Auth - Super Admin (자동 승인 이메일)
# ─────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com

# ─────────────────────────────────────────────────────────────
# Frontend URL (OAuth 리다이렉트용)
# ─────────────────────────────────────────────────────────────
ADMIN_FRONTEND_URL=http://localhost:13001  # 반드시 http:// 또는 https:// 포함 필수

# ─────────────────────────────────────────────────────────────
# Weaviate (Vector Database)
# ─────────────────────────────────────────────────────────────
# 로컬: localhost:18080 | Docker: weaviate:8080
WEAVIATE_HOST=localhost
WEAVIATE_PORT=18080

# ─────────────────────────────────────────────────────────────
# Flower (Celery Monitoring)
# ─────────────────────────────────────────────────────────────
# 로컬: localhost:15555 | Docker: flower:5555
FLOWER_HOST=localhost
FLOWER_PORT=15555
FLOWER_USER=admin
FLOWER_PASSWORD=flower_dev_2024

# ─────────────────────────────────────────────────────────────
# User Backend (FastAPI - RAG Service)
# ─────────────────────────────────────────────────────────────
# 로컬: http://localhost:8000 | Docker: http://service-backend:8000
USER_BACKEND_URL=http://localhost:8000
