# Next.js 개발용 Dockerfile
FROM node:20-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

# 패키지 파일 복사
COPY package.json package-lock.json* ./

# 의존성 설치
RUN npm ci

# 소스 코드 복사 (볼륨 마운트로 덮어씌워짐)
COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 13001

# 개발 서버 실행 (hot reload)
CMD ["npm", "run", "dev"]
