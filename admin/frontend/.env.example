# ============================================
# OARIA Admin Frontend 환경 변수
# ============================================
# .env.example → .env.local로 복사 후 사용
# Next.js는 .env.local을 자동으로 로드함

# ============================================
# API URL (필수)
# ============================================
# 브라우저에서 접근하는 Admin Backend API URL
# 로컬 개발: http://localhost:13000
# Docker 개발: http://localhost:13000
# 클라우드: https://admin-api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:13000

# ============================================
# Docker 컨테이너 참고 (서버사이드 통신용)
# ============================================
# docker-compose.yml 내부 서비스 이름:
#   - service-backend: User Backend (FastAPI) - 포트 8000
#   - service-frontend: User Frontend (Next.js) - 포트 3000
#   - admin-backend: Admin Backend (NestJS) - 포트 13000
#   - admin-frontend: Admin Frontend (Next.js) - 포트 13001
#   - postgres: PostgreSQL - 포트 5432
#   - redis: Redis - 포트 6379
#   - minio: MinIO - 포트 9000
#   - weaviate: Weaviate - 포트 8080
#   - flower: Flower - 포트 5555
#
# 서버사이드(SSR)에서 Docker 내부 통신 시:
#   API_URL=http://admin-backend:13000 (docker-compose.yml에서 설정)
